{
  "name": "@mcp-studio/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "STUDIO_DB_PATH=:memory: bun test src/__tests__",
    "test:watch": "STUDIO_DB_PATH=:memory: bun test --watch src/__tests__",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@mcp-studio/mcp-client": "workspace:*",
    "@mcp-studio/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "bun-types": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
