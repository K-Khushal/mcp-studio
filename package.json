{
  "name": "mcp-studio",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build && bun scripts/build-package.ts",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "smoke": "bun scripts/smoke-cli.ts",
    "prepack": "bun run build"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "0.1.0",
  "description": "Local MCP server inspector powered by Bun",
  "bin": {
    "mcp-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K-Khushal/mcp-studio.git"
  }
}
